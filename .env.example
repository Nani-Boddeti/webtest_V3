# ORCA Companion environment configuration
# Copy this file to .env and adjust as needed.
# No secrets are required for local development.

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Override the base path for animation assets (default: assets/animations)
ANIMATIONS_BASE_PATH=assets/animations

# Disable win10toast notifications when set to 1
ORCA_NO_TOAST=0
